# Optional backend configuration. No model credentials are needed at this stage.
# These variables are read from the process environment; this file is NOT loaded
# automatically. Use absolute paths when running outside the repository.
# QBRIDGE_EXPERIMENT_DIR=/absolute/path/to/Q-Bridge/results/experiments
# QBRIDGE_RESEARCH_DIR=/absolute/path/to/Q-Bridge/research

# Assistant: SAFE DEFAULTS. Export these in the backend terminal if needed.
QBRIDGE_ASSISTANT_MODE=mock
QBRIDGE_ASSISTANT_DISABLED=false
QBRIDGE_LIVE_AUTHORIZED=no
# MODEL_API_KEY is read only in explicitly authorized live mode.
# Never put a model key in frontend files or a VITE_ variable.
